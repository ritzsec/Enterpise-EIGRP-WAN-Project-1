hostname BRANCH_3_R1

interface f2/0
 ip address 192.168.3.10 255.255.255.0
 no shutdown

interface f0/0
 ip address 172.16.21.10 255.255.255.0
 no shutdown

interface f1/0
 ip address 172.16.22.10 255.255.255.0
 no shutdown

router eigrp 100
 no auto-summary
 network 192.168.3.0
 network 172.16.21.0
 network 172.16.22.0

interface f2/0
 vrrp 1 ip 192.168.3.100
 vrrp 1 priority 120
 vrrp 1 preempt
