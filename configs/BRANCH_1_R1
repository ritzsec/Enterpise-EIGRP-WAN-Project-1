hostname BRANCH_1_R1

interface f2/0
 ip address 192.168.1.10 255.255.255.0
 no shutdown

interface f0/0
 ip address 172.16.13.10 255.255.255.0
 no shutdown

interface f1/0
 ip address 172.16.14.10 255.255.255.0
 no shutdown

router eigrp 100
 no auto-summary
 network 192.168.1.0
 network 172.16.13.0
 network 172.16.14.0

interface f2/0
 vrrp 1 ip 192.168.1.100
 vrrp 1 priority 120
 vrrp 1 preempt
